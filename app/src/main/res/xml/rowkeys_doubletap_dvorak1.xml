<?xml version="1.0" encoding="utf-8"?>
<!-- Double-tap Dvorak row 1: '·,  .·p  y·f  g·c  r·l  (5 pairs × 20%) -->
<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <switch>
        <case latin:showNumberRow="true">
            <Key latin:keySpec="\'" latin:keySecondarySpec="\," />
            <Key latin:keySpec="." latin:keySecondarySpec="p"
                latin:keyHintLabel="="
                latin:moreKeys="!splitTopRow!1,=" />
            <Key latin:keySpec="y" latin:keySecondarySpec="f" latin:moreKeys="!splitTopRow!2,!text/morekeys_y,[,]"
                latin:keyHintLabel="]"
                latin:keyHintLabelLeft="[" />
            <Key latin:keySpec="g" latin:keySecondarySpec="c" latin:moreKeys="!splitTopRow!2,!text/morekeys_g,!text/morekeys_c,&lt;,&gt;"
                latin:keyHintLabel="&gt;"
                latin:keyHintLabelLeft="&lt;" />
            <Key latin:keySpec="r" latin:keySecondarySpec="l" latin:moreKeys="!splitTopRow!2,!text/morekeys_r,!text/morekeys_l,},{"
                latin:keyHintLabel="}"
                latin:keyHintLabelLeft="{" />
        </case>
        <default>
            <Key latin:keySpec="\'" latin:keySecondarySpec="\,"
                latin:keyHintLabelLeft="1"
                latin:keyHintLabel="2"
                latin:moreKeys="!splitTopRow!2,1,2" />
            <Key latin:keySpec="." latin:keySecondarySpec="p"
                latin:keyHintLabelLeft="3"
                latin:keyHintLabel="4"
                latin:moreKeys="!splitTopRow!2,3,4" />
            <Key latin:keySpec="y" latin:keySecondarySpec="f" latin:moreKeys="!splitTopRow!2,!text/morekeys_y,5,6"
                latin:keyHintLabelLeft="5"
                latin:keyHintLabel="6" />
            <Key latin:keySpec="g" latin:keySecondarySpec="c" latin:moreKeys="!splitTopRow!2,!text/morekeys_g,!text/morekeys_c,7,8"
                latin:keyHintLabelLeft="7"
                latin:keyHintLabel="8" />
            <Key latin:keySpec="r" latin:keySecondarySpec="l" latin:moreKeys="!splitTopRow!2,!text/morekeys_r,!text/morekeys_l,0,9"
                latin:keyHintLabelLeft="9"
                latin:keyHintLabel="0" />
        </default>
    </switch>
</merge>
