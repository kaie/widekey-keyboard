<?xml version="1.0" encoding="utf-8"?>
<!-- Double-tap Bépo row 1: b·é  p·o  w·v  d·l  j·z  (5 pairs × 20%) -->
<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <switch>
        <case latin:showNumberRow="true">
            <Key latin:keySpec="b"
                latin:keySecondarySpec="é"
                latin:moreKeys="!splitTopRow!2,!text/morekeys_e,_,\\"
                latin:keyHintLabel="\\"
                latin:keyHintLabelLeft="_" />
            <Key latin:keySpec="p"
                latin:keySecondarySpec="o"
                latin:moreKeys="!splitTopRow!2,!text/morekeys_o,\|,="
                latin:keyHintLabel="="
                latin:keyHintLabelLeft="|" />
            <Key latin:keySpec="w"
                latin:keySecondarySpec="v"
                latin:moreKeys="!splitTopRow!2,!text/morekeys_w,!text/morekeys_v,[,]"
                latin:keyHintLabel="]"
                latin:keyHintLabelLeft="[" />
            <Key latin:keySpec="d"
                latin:keySecondarySpec="l"
                latin:moreKeys="!splitTopRow!2,!text/morekeys_d,!text/morekeys_l,&lt;,&gt;"
                latin:keyHintLabel="&gt;"
                latin:keyHintLabelLeft="&lt;" />
            <Key latin:keySpec="j"
                latin:keySecondarySpec="z"
                latin:moreKeys="!splitTopRow!2,!text/morekeys_j,!text/morekeys_z,},{"
                latin:keyHintLabel="}"
                latin:keyHintLabelLeft="{" />
        </case>
        <default>
            <Key latin:keySpec="b"
                latin:keySecondarySpec="é"
                latin:moreKeys="!splitTopRow!2,!text/morekeys_e,1,2"
                latin:keyHintLabelLeft="1"
                latin:keyHintLabel="2" />
            <Key latin:keySpec="p"
                latin:keySecondarySpec="o"
                latin:moreKeys="!splitTopRow!2,!text/morekeys_o,3,4"
                latin:keyHintLabelLeft="3"
                latin:keyHintLabel="4" />
            <Key latin:keySpec="w"
                latin:keySecondarySpec="v"
                latin:moreKeys="!splitTopRow!2,!text/morekeys_w,!text/morekeys_v,5,6"
                latin:keyHintLabelLeft="5"
                latin:keyHintLabel="6" />
            <Key latin:keySpec="d"
                latin:keySecondarySpec="l"
                latin:moreKeys="!splitTopRow!2,!text/morekeys_d,!text/morekeys_l,7,8"
                latin:keyHintLabelLeft="7"
                latin:keyHintLabel="8" />
            <Key latin:keySpec="j"
                latin:keySecondarySpec="z"
                latin:moreKeys="!splitTopRow!2,!text/morekeys_j,!text/morekeys_z,0,9"
                latin:keyHintLabelLeft="9"
                latin:keyHintLabel="0" />
        </default>
    </switch>
</merge>
