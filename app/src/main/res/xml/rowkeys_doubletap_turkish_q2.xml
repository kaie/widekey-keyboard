<?xml version="1.0" encoding="utf-8"?>
<!-- Double-tap Turkish Q row 2: a·s  d·f  g·h  j·k  l·ş  i·ç  (6 pairs × 16.667%)
     ç moved UP from row 3 to pair with i. -->
<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <Key latin:keySpec="a"
        latin:keySecondarySpec="s"
        latin:moreKeys="!splitTopRow!2,!text/morekeys_a,!text/morekeys_s,\@,#"
        latin:keyHintLabel="#"
        latin:keyHintLabelLeft="\@" />
    <Key latin:keySpec="d"
        latin:keySecondarySpec="f"
        latin:moreKeys="!splitTopRow!2,!text/morekeys_d,$,\\%"
        latin:keyHintLabel="%"
        latin:keyHintLabelLeft="$" />
    <Key latin:keySpec="g"
        latin:keySecondarySpec="h"
        latin:moreKeys="!splitTopRow!2,!text/morekeys_g,!text/morekeys_h,&amp;,-"
        latin:keyHintLabel="-"
        latin:keyHintLabelLeft="&amp;" />
    <Key latin:keySpec="j"
        latin:keySecondarySpec="k"
        latin:moreKeys="!splitTopRow!2,!text/morekeys_j,!text/morekeys_k,+,("
        latin:keyHintLabel="("
        latin:keyHintLabelLeft="+" />
    <!-- ş: LATIN SMALL LETTER S WITH CEDILLA -->
    <Key latin:keySpec="l"
        latin:keySecondarySpec="ş"
        latin:moreKeys="!splitTopRow!2,!text/morekeys_l,),×"
        latin:keyHintLabel="×"
        latin:keyHintLabelLeft=")" />
    <!-- i: Turkish dotted i  ç: LATIN SMALL LETTER C WITH CEDILLA (moved up) -->
    <Key latin:keySpec="i"
        latin:keySecondarySpec="ç"
        latin:moreKeys="!splitTopRow!1,!text/morekeys_i,!text/morekeys_c,÷"
        latin:keyHintLabelLeft="÷" />
</merge>
