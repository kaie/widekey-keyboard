<?xml version="1.0" encoding="utf-8"?>
<!-- Double-tap ABC row 2: k·l  m·n  o·p  q·r  s·t  (5 pairs × 20%; t moved up from row 3) -->
<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <!-- k·l: left=@(k) right=#(l) -->
    <Key latin:keySpec="k" latin:keySecondarySpec="l" latin:moreKeys="!splitTopRow!2,!text/morekeys_k,!text/morekeys_l,\@,#"
        latin:keyHintLabel="#"
        latin:keyHintLabelLeft="\@" />
    <!-- m·n: left=$(m) right=%(n) -->
    <Key latin:keySpec="m" latin:keySecondarySpec="n" latin:moreKeys="!splitTopRow!2,!text/morekeys_n,$,\\%"
        latin:keyHintLabel="%"
        latin:keyHintLabelLeft="$" />
    <!-- o·p: left=&(o) right=-(p) -->
    <Key latin:keySpec="o" latin:keySecondarySpec="p" latin:moreKeys="!splitTopRow!2,!text/morekeys_o,&amp;,-"
        latin:keyHintLabel="-"
        latin:keyHintLabelLeft="&amp;" />
    <!-- q·r: left=+(q) right=((r) -->
    <Key latin:keySpec="q" latin:keySecondarySpec="r" latin:moreKeys="!splitTopRow!2,!text/morekeys_q,!text/morekeys_r,+,("
        latin:keyHintLabel="("
        latin:keyHintLabelLeft="+" />
    <!-- s·t: left=)(s) right=*(t) — right-edge: additionalMoreKeys right-first -->
    <Key latin:keySpec="s" latin:keySecondarySpec="t" latin:moreKeys="!splitTopRow!2,!text/morekeys_s,!text/morekeys_t,*,)"
        latin:keyHintLabel="*"
        latin:keyHintLabelLeft=")" />
</merge>
