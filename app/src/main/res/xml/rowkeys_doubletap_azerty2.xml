<?xml version="1.0" encoding="utf-8"?>
<!-- Double-tap AZERTY row 2: q·s  d·f  g·h  j·k  l·m  (5 pairs × 20%)
     Row 2 is already 10 keys in AZERTY, no stagger or move needed. -->
<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <Key latin:keySpec="q"
        latin:keySecondarySpec="s"
        latin:moreKeys="!splitTopRow!2,!text/morekeys_s,\@,#"
        latin:keyHintLabel="#"
        latin:keyHintLabelLeft="\@" />
    <Key latin:keySpec="d"
        latin:keySecondarySpec="f"
        latin:moreKeys="!splitTopRow!2,!text/morekeys_d,$,\\%"
        latin:keyHintLabel="%"
        latin:keyHintLabelLeft="$" />
    <Key latin:keySpec="g"
        latin:keySecondarySpec="h"
        latin:moreKeys="!splitTopRow!2,!text/morekeys_g,!text/morekeys_h,&amp;,-"
        latin:keyHintLabel="-"
        latin:keyHintLabelLeft="&amp;" />
    <Key latin:keySpec="j"
        latin:keySecondarySpec="k"
        latin:moreKeys="!splitTopRow!2,!text/morekeys_j,!text/morekeys_k,+,("
        latin:keyHintLabel="("
        latin:keyHintLabelLeft="+" />
    <Key latin:keySpec="l"
        latin:keySecondarySpec="m"
        latin:moreKeys="!splitTopRow!2,!text/morekeys_l,/,)"
        latin:keyHintLabel="/"
        latin:keyHintLabelLeft=")" />
</merge>
