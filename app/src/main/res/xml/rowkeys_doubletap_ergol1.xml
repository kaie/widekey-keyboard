<?xml version="1.0" encoding="utf-8"?>
<!-- Double-tap Ergol row 1: q·c  o·p  w·j  m·d  !·y  (5 pairs × 20%) -->
<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <switch>
        <case latin:showNumberRow="true">
            <Key latin:keySpec="q"
                latin:keySecondarySpec="c"
                latin:moreKeys="!splitTopRow!2,!text/morekeys_q,!text/morekeys_c,^,&lt;"
                latin:keyHintLabel="&lt;"
                latin:keyHintLabelLeft="^" />
            <Key latin:keySpec="o"
                latin:keySecondarySpec="p"
                latin:moreKeys="!splitTopRow!2,!text/morekeys_o,&gt;,$"
                latin:keyHintLabel="$"
                latin:keyHintLabelLeft="&gt;" />
            <Key latin:keySpec="w"
                latin:keySecondarySpec="j"
                latin:moreKeys="!splitTopRow!2,!text/morekeys_w,!text/morekeys_j,\\%,\@"
                latin:keyHintLabel="\@"
                latin:keyHintLabelLeft="%" />
            <Key latin:keySpec="m"
                latin:keySecondarySpec="d"
                latin:moreKeys="!splitTopRow!2,!text/morekeys_d,&amp;,*"
                latin:keyHintLabel="*"
                latin:keyHintLabelLeft="&amp;" />
            <Key latin:keySpec="!"
                latin:keySecondarySpec="y"
                latin:moreKeys="!splitTopRow!2,!text/morekeys_!,!text/morekeys_y,`,'"
                latin:keyHintLabel="`"
                latin:keyHintLabelLeft="'" />
        </case>
        <default>
            <Key latin:keySpec="q"
                latin:keySecondarySpec="c"
                latin:moreKeys="!splitTopRow!2,!text/morekeys_q,!text/morekeys_c,1,2"
                latin:keyHintLabelLeft="1"
                latin:keyHintLabel="2" />
            <Key latin:keySpec="o"
                latin:keySecondarySpec="p"
                latin:moreKeys="!splitTopRow!2,!text/morekeys_o,3,4"
                latin:keyHintLabelLeft="3"
                latin:keyHintLabel="4" />
            <Key latin:keySpec="w"
                latin:keySecondarySpec="j"
                latin:moreKeys="!splitTopRow!2,!text/morekeys_w,!text/morekeys_j,5,6"
                latin:keyHintLabelLeft="5"
                latin:keyHintLabel="6" />
            <Key latin:keySpec="m"
                latin:keySecondarySpec="d"
                latin:moreKeys="!splitTopRow!2,!text/morekeys_d,7,8"
                latin:keyHintLabelLeft="7"
                latin:keyHintLabel="8" />
            <Key latin:keySpec="!"
                latin:keySecondarySpec="y"
                latin:moreKeys="!splitTopRow!2,!text/morekeys_!,!text/morekeys_y,0,9"
                latin:keyHintLabelLeft="9"
                latin:keyHintLabel="0" />
        </default>
    </switch>
</merge>
