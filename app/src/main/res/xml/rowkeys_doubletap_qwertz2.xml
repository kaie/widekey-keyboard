<?xml version="1.0" encoding="utf-8"?>
<!-- Double-tap QWERTZ row 2: a·s  d·f  g·h  j·k  l·m  (5 pairs × 20%, no stagger)
     'm' moved up from row 3 to make both rows even. -->
<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <!-- morekeys_s included for ß access (normally on long-press of 's') -->
    <Key latin:keySpec="a"
        latin:keySecondarySpec="s"
        latin:moreKeys="!splitTopRow!2,!text/morekeys_a,!text/morekeys_s,\@,#"
        latin:keyHintLabel="#"
        latin:keyHintLabelLeft="\@" />
    <Key latin:keySpec="d"
        latin:keySecondarySpec="f"
        latin:moreKeys="!splitTopRow!2,!text/morekeys_d,$,\\%"
        latin:keyHintLabel="%"
        latin:keyHintLabelLeft="$" />
    <Key latin:keySpec="g"
        latin:keySecondarySpec="h"
        latin:moreKeys="!splitTopRow!2,!text/morekeys_g,!text/morekeys_h,&amp;,-"
        latin:keyHintLabel="-"
        latin:keyHintLabelLeft="&amp;" />
    <Key latin:keySpec="j"
        latin:keySecondarySpec="k"
        latin:moreKeys="!splitTopRow!2,!text/morekeys_j,!text/morekeys_k,+,("
        latin:keyHintLabel="("
        latin:keyHintLabelLeft="+" />
    <Key latin:keySpec="l"
        latin:keySecondarySpec="m"
        latin:moreKeys="!splitTopRow!2,!text/morekeys_l,\?,)"
        latin:keyHintLabel="\?"
        latin:keyHintLabelLeft=")" />
</merge>
