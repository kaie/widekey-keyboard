<?xml version="1.0" encoding="utf-8"?>
<!-- Double-tap QWERTY row 1: q·w  e·r  t·y  u·i  o·p  (5 pairs × 20%) -->
<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <switch>
        <case latin:showNumberRow="true">
            <Key latin:keySpec="q"
                latin:keySecondarySpec="w"
                latin:moreKeys="!splitTopRow!2,!text/morekeys_w,_,\\"
                latin:keyHintLabel="\\"
                latin:keyHintLabelLeft="_" />
            <Key latin:keySpec="e"
                latin:keySecondarySpec="r"
                latin:moreKeys="!splitTopRow!2,!text/morekeys_e,!text/morekeys_r,\|,="
                latin:keyHintLabel="="
                latin:keyHintLabelLeft="|" />
            <Key latin:keySpec="t"
                latin:keySecondarySpec="y"
                latin:moreKeys="!splitTopRow!2,!text/morekeys_t,!text/morekeys_y,[,]"
                latin:keyHintLabel="]"
                latin:keyHintLabelLeft="[" />
            <Key latin:keySpec="u"
                latin:keySecondarySpec="i"
                latin:moreKeys="!splitTopRow!2,!text/morekeys_u,!text/morekeys_i,&lt;,&gt;"
                latin:keyHintLabel="&gt;"
                latin:keyHintLabelLeft="&lt;" />
            <Key latin:keySpec="o"
                latin:keySecondarySpec="p"
                latin:moreKeys="!splitTopRow!2,!text/morekeys_o,},{"
                latin:keyHintLabel="}"
                latin:keyHintLabelLeft="{" />
        </case>
        <default>
            <Key latin:keySpec="q"
                latin:keySecondarySpec="w"
                latin:moreKeys="!splitTopRow!2,!text/morekeys_w,1,2"
                latin:keyHintLabelLeft="1"
                latin:keyHintLabel="2" />
            <Key latin:keySpec="e"
                latin:keySecondarySpec="r"
                latin:moreKeys="!splitTopRow!2,!text/morekeys_e,!text/morekeys_r,3,4"
                latin:keyHintLabelLeft="3"
                latin:keyHintLabel="4" />
            <Key latin:keySpec="t"
                latin:keySecondarySpec="y"
                latin:moreKeys="!splitTopRow!2,!text/morekeys_t,!text/morekeys_y,5,6"
                latin:keyHintLabelLeft="5"
                latin:keyHintLabel="6" />
            <Key latin:keySpec="u"
                latin:keySecondarySpec="i"
                latin:moreKeys="!splitTopRow!2,!text/morekeys_u,!text/morekeys_i,7,8"
                latin:keyHintLabelLeft="7"
                latin:keyHintLabel="8" />
            <Key latin:keySpec="o"
                latin:keySecondarySpec="p"
                latin:moreKeys="!splitTopRow!2,!text/morekeys_o,0,9"
                latin:keyHintLabelLeft="9"
                latin:keyHintLabel="0" />
        </default>
    </switch>
</merge>
