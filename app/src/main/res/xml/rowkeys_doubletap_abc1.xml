<?xml version="1.0" encoding="utf-8"?>
<!-- Double-tap ABC row 1: a·b  c·d  e·f  g·h  i·j  (5 pairs × 20%) -->
<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <switch>
        <case latin:showNumberRow="true">
            <!-- a·b: left=_(a) right=\(b) -->
            <Key latin:keySpec="a" latin:keySecondarySpec="b" latin:moreKeys="!splitTopRow!2,!text/morekeys_a,_,\\"
                latin:keyHintLabel="\\"
                latin:keyHintLabelLeft="_" />
            <!-- c·d: left=|(c) right==(d) -->
            <Key latin:keySpec="c" latin:keySecondarySpec="d" latin:moreKeys="!splitTopRow!2,!text/morekeys_c,!text/morekeys_d,\|,="
                latin:keyHintLabel="="
                latin:keyHintLabelLeft="|" />
            <!-- e·f: left=[(e) right=](f) -->
            <Key latin:keySpec="e" latin:keySecondarySpec="f" latin:moreKeys="!splitTopRow!2,!text/morekeys_e,[,]"
                latin:keyHintLabel="]"
                latin:keyHintLabelLeft="[" />
            <!-- g·h: left=<(g) right=>(h) -->
            <Key latin:keySpec="g" latin:keySecondarySpec="h" latin:moreKeys="!splitTopRow!2,!text/morekeys_g,!text/morekeys_h,&lt;,&gt;"
                latin:keyHintLabel="&gt;"
                latin:keyHintLabelLeft="&lt;" />
            <!-- i·j: left={(i) right=}(j) — right-edge: additionalMoreKeys right-first -->
            <Key latin:keySpec="i" latin:keySecondarySpec="j" latin:moreKeys="!splitTopRow!2,!text/morekeys_i,!text/morekeys_j,},{"
                latin:keyHintLabel="}"
                latin:keyHintLabelLeft="{" />
        </case>
        <default>
            <Key latin:keySpec="a" latin:keySecondarySpec="b" latin:moreKeys="!splitTopRow!2,!text/morekeys_a,1,2"
                latin:keyHintLabelLeft="1"
                latin:keyHintLabel="2" />
            <Key latin:keySpec="c" latin:keySecondarySpec="d" latin:moreKeys="!splitTopRow!2,!text/morekeys_c,!text/morekeys_d,3,4"
                latin:keyHintLabelLeft="3"
                latin:keyHintLabel="4" />
            <Key latin:keySpec="e" latin:keySecondarySpec="f" latin:moreKeys="!splitTopRow!2,!text/morekeys_e,5,6"
                latin:keyHintLabelLeft="5"
                latin:keyHintLabel="6" />
            <Key latin:keySpec="g" latin:keySecondarySpec="h" latin:moreKeys="!splitTopRow!2,!text/morekeys_g,!text/morekeys_h,7,8"
                latin:keyHintLabelLeft="7"
                latin:keyHintLabel="8" />
            <Key latin:keySpec="i" latin:keySecondarySpec="j" latin:moreKeys="!splitTopRow!2,!text/morekeys_i,!text/morekeys_j,0,9"
                latin:keyHintLabelLeft="9"
                latin:keyHintLabel="0" />
        </default>
    </switch>
</merge>
