<?xml version="1.0" encoding="utf-8"?>
<!-- Double-tap HCesar row 1: h·c  e·s  a·r  o·p  z·,  (5 pairs × 20%)
     The conditional «/, key is simplified to comma secondary with « in moreKeys. -->
<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <switch>
        <case latin:showNumberRow="true">
            <Key latin:keySpec="h"
                latin:keySecondarySpec="c"
                latin:moreKeys="!splitTopRow!2,!text/morekeys_c,-,\\"
                latin:keyHintLabel="\\"
                latin:keyHintLabelLeft="-" />
            <Key latin:keySpec="e"
                latin:keySecondarySpec="s"
                latin:moreKeys="!splitTopRow!2,!text/morekeys_e,\|,="
                latin:keyHintLabel="="
                latin:keyHintLabelLeft="|" />
            <Key latin:keySpec="a"
                latin:keySecondarySpec="r"
                latin:moreKeys="!splitTopRow!2,!text/morekeys_a,[,]"
                latin:keyHintLabel="]"
                latin:keyHintLabelLeft="[" />
            <Key latin:keySpec="o"
                latin:keySecondarySpec="p"
                latin:moreKeys="!splitTopRow!2,!text/morekeys_o,&lt;,&gt;"
                latin:keyHintLabel="&gt;"
                latin:keyHintLabelLeft="&lt;" />
            <!-- U+00AB: "«" LEFT-POINTING DOUBLE ANGLE QUOTATION MARK in moreKeys -->
            <Key latin:keySpec="z"
                latin:keySecondarySpec=","
                latin:moreKeys="!splitTopRow!1,&#x00AB;,{"
                latin:keyHintLabelLeft="{" />
        </case>
        <default>
            <Key latin:keySpec="h"
                latin:keySecondarySpec="c"
                latin:moreKeys="!splitTopRow!2,!text/morekeys_c,1,2"
                latin:keyHintLabelLeft="1"
                latin:keyHintLabel="2" />
            <Key latin:keySpec="e"
                latin:keySecondarySpec="s"
                latin:moreKeys="!splitTopRow!2,!text/morekeys_e,3,4"
                latin:keyHintLabelLeft="3"
                latin:keyHintLabel="4" />
            <Key latin:keySpec="a"
                latin:keySecondarySpec="r"
                latin:moreKeys="!splitTopRow!2,!text/morekeys_a,5,6"
                latin:keyHintLabelLeft="5"
                latin:keyHintLabel="6" />
            <Key latin:keySpec="o"
                latin:keySecondarySpec="p"
                latin:moreKeys="!splitTopRow!2,!text/morekeys_o,7,8"
                latin:keyHintLabelLeft="7"
                latin:keyHintLabel="8" />
            <!-- U+00AB: "«" LEFT-POINTING DOUBLE ANGLE QUOTATION MARK in moreKeys -->
            <Key latin:keySpec="z"
                latin:keySecondarySpec=","
                latin:moreKeys="!splitTopRow!2,&#x00AB;,0,9"
                latin:keyHintLabelLeft="9"
                latin:keyHintLabel="0" />
        </default>
    </switch>
</merge>
