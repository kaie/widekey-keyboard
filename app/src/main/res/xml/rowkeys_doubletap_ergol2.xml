<?xml version="1.0" encoding="utf-8"?>
<!-- Double-tap Ergol row 2: a·s  e·n  f·l  r·t  i·u  (5 pairs × 20%) -->
<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <Key latin:keySpec="a"
        latin:keySecondarySpec="s"
        latin:moreKeys="!splitTopRow!2,!text/morekeys_a,!text/morekeys_s,{,("
        latin:keyHintLabel="("
        latin:keyHintLabelLeft="{" />
    <Key latin:keySpec="e"
        latin:keySecondarySpec="n"
        latin:moreKeys="!splitTopRow!2,!text/morekeys_e,!text/morekeys_n,),}"
        latin:keyHintLabel="}"
        latin:keyHintLabelLeft=")" />
    <Key latin:keySpec="f"
        latin:keySecondarySpec="l"
        latin:moreKeys="!splitTopRow!2,!text/morekeys_l,=,\\"
        latin:keyHintLabel="\\"
        latin:keyHintLabelLeft="=" />
    <Key latin:keySpec="r"
        latin:keySecondarySpec="t"
        latin:moreKeys="!splitTopRow!2,!text/morekeys_r,!text/morekeys_t,+,-"
        latin:keyHintLabel="-"
        latin:keyHintLabelLeft="+" />
    <Key latin:keySpec="i"
        latin:keySecondarySpec="u"
        latin:moreKeys="!splitTopRow!2,!text/morekeys_i,!text/morekeys_u,&quot;,/"
        latin:keyHintLabel="&quot;"
        latin:keyHintLabelLeft="/" />
</merge>
