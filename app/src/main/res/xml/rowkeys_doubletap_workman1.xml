<?xml version="1.0" encoding="utf-8"?>
<!-- Double-tap Workman row 1: q·d  r·w  b·j  f·u  p·;  (5 pairs × 20%) -->
<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <switch>
        <case latin:showNumberRow="true">
            <Key latin:keySpec="q" latin:keySecondarySpec="d" latin:moreKeys="!splitTopRow!2,!text/morekeys_w,_,\\"
                latin:keyHintLabel="\\"
                latin:keyHintLabelLeft="_" />
            <Key latin:keySpec="r" latin:keySecondarySpec="w"
                latin:keyHintLabel="="
                latin:keyHintLabelLeft="|"
                latin:moreKeys="!splitTopRow!2,\|,=" />
            <Key latin:keySpec="b" latin:keySecondarySpec="j" latin:moreKeys="!splitTopRow!2,!text/morekeys_g,!text/morekeys_j,[,]"
                latin:keyHintLabel="]"
                latin:keyHintLabelLeft="[" />
            <Key latin:keySpec="f" latin:keySecondarySpec="u" latin:moreKeys="!splitTopRow!2,!text/morekeys_l,!text/morekeys_u,&gt;,&lt;"
                latin:keyHintLabel="&gt;"
                latin:keyHintLabelLeft="&lt;" />
            <Key latin:keySpec="p" latin:keySecondarySpec=";" latin:moreKeys="!splitTopRow!1,!text/morekeys_y,{"
                latin:keyHintLabelLeft="{" />
        </case>
        <default>
            <Key latin:keySpec="q" latin:keySecondarySpec="d" latin:moreKeys="!splitTopRow!2,!text/morekeys_w,1,2"
                latin:keyHintLabelLeft="1"
                latin:keyHintLabel="2" />
            <Key latin:keySpec="r" latin:keySecondarySpec="w"
                latin:keyHintLabelLeft="3"
                latin:keyHintLabel="4"
                latin:moreKeys="!splitTopRow!2,3,4" />
            <Key latin:keySpec="b" latin:keySecondarySpec="j" latin:moreKeys="!splitTopRow!2,!text/morekeys_g,!text/morekeys_j,5,6"
                latin:keyHintLabelLeft="5"
                latin:keyHintLabel="6" />
            <Key latin:keySpec="f" latin:keySecondarySpec="u" latin:moreKeys="!splitTopRow!2,!text/morekeys_l,!text/morekeys_u,7,8"
                latin:keyHintLabelLeft="7"
                latin:keyHintLabel="8" />
            <Key latin:keySpec="p" latin:keySecondarySpec=";" latin:moreKeys="!splitTopRow!2,!text/morekeys_y,0,9"
                latin:keyHintLabelLeft="9"
                latin:keyHintLabel="0" />
        </default>
    </switch>
</merge>
