<?xml version="1.0" encoding="utf-8"?>
<!-- Double-tap Colemak row 2: a·r  s·t  d·h  n·e  i·o  (5 pairs × 20%) -->
<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <Key latin:keySpec="a" latin:keySecondarySpec="r" latin:moreKeys="!splitTopRow!2,!text/morekeys_a,!text/morekeys_r,\@,#"
        latin:keyHintLabel="#"
        latin:keyHintLabelLeft="\@" />
    <Key latin:keySpec="s" latin:keySecondarySpec="t" latin:moreKeys="!splitTopRow!2,!text/morekeys_s,!text/morekeys_t,$,\\%"
        latin:keyHintLabel="%"
        latin:keyHintLabelLeft="$" />
    <Key latin:keySpec="d" latin:keySecondarySpec="h" latin:moreKeys="!splitTopRow!2,!text/morekeys_d,!text/morekeys_h,&amp;,-"
        latin:keyHintLabel="-"
        latin:keyHintLabelLeft="&amp;" />
    <Key latin:keySpec="n" latin:keySecondarySpec="e" latin:moreKeys="!splitTopRow!2,!text/morekeys_n,!text/morekeys_e,+,("
        latin:keyHintLabel="("
        latin:keyHintLabelLeft="+" />
    <Key latin:keySpec="i" latin:keySecondarySpec="o" latin:moreKeys="!splitTopRow!2,!text/morekeys_i,!text/morekeys_o,/,)"
        latin:keyHintLabel="/"
        latin:keyHintLabelLeft=")" />
</merge>
