<?xml version="1.0" encoding="utf-8"?>
<!-- Double-tap Turkish Q row 3: z·x  c·v  b·n  m·ö  (4 pairs × 17.75%)
     ç moved UP to row 2. ö pairs with m. -->
<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <Key latin:keySpec="z"
        latin:keySecondarySpec="x"
        latin:moreKeys="!splitTopRow!2,!text/morekeys_z,!text/morekeys_x,*,&quot;"
        latin:keyHintLabel="&quot;"
        latin:keyHintLabelLeft="*" />
    <Key latin:keySpec="c"
        latin:keySecondarySpec="v"
        latin:moreKeys="!splitTopRow!2,!text/morekeys_c,!text/morekeys_v,',:"
        latin:keyHintLabel=":"
        latin:keyHintLabelLeft="'" />
    <Key latin:keySpec="b"
        latin:keySecondarySpec="n"
        latin:moreKeys="!splitTopRow!2,!text/morekeys_n,;,!"
        latin:keyHintLabel="!"
        latin:keyHintLabelLeft=";" />
    <!-- ö: LATIN SMALL LETTER O WITH DIAERESIS -->
    <Key latin:keySpec="m"
        latin:keySecondarySpec="ö"
        latin:moreKeys="!splitTopRow!2,!text/morekeys_o,\?,/"
        latin:keyHintLabel="/"
        latin:keyHintLabelLeft="\?" />
</merge>
